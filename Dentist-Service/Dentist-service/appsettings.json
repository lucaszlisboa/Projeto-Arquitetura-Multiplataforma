{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PaymentService": {
    "BaseUrl": "http://localhost:5127"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dentist_service;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "dentist-service",
    "Enabled": true,
    "Outbox": {
      "PollingIntervalMs": 1000,
      "BatchSize": 50
    },
    "Consumer": {
      "GroupId": "dentist-service",
      "Topics": [ "payments", "health-insurance" ],
      "MaxRetries": 3,
      "RetryDelayMs": 1000
    }
  }
}
