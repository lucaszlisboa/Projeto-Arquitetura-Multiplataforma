# Copie para .env para personalizar portas e credenciais locais.
POSTGRES_PASSWORD=postgres
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

BFF_PORT=3000
BFF_MOCK_PORT=3002
DENTIST_PORT=5068
EMPLOYEE_PORT=5070
PATIENT_PORT=5072
PAYMENT_PORT=5127
KEYCLOAK_PORT=8080
KAFKA_PORT=9092
KAFKA_UI_PORT=8081

DENTIST_DB_PORT=5432
PAYMENT_DB_PORT=5433
EMPLOYEE_DB_PORT=5434
KEYCLOAK_DB_PORT=5435
PATIENT_DB_PORT=5437

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
KAFKA_EXPORTER_PORT=9308

ELK_VERSION=8.17.4
ES_PORT=9200
KIBANA_PORT=5601
ES_JAVA_OPTS=-Xms512m -Xmx512m
LS_JAVA_OPTS=-Xms256m -Xmx256m

# Origens web permitidas pelo BFF. Separe múltiplas origens por vírgula.
CORS_ORIGINS=
